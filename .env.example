# VM deployment environment (copy to .env)
# Used by deploy/docker-compose.vm.yml (mongo/backend env_file)

NODE_ENV=production
APP_PORT=5022
MONGODB_URI=mongodb://mongo:27017/blindbox

JWT_SECRET=replace-with-strong-random-string
JWT_EXPIRY=7d

SUPER_ADMIN_PHONE=+254700000001
SUPER_ADMIN_PASSWORD=replace-with-strong-password
DAILY_DRAW_LIMIT=3

MERCHANT_ID=ke7stg
# Set to externally reachable entrypoint of this project (IP-first)
MERCHANT_REDIRECT_URL=http://<VM_IP>/auth/sso

DO_SPACES_ENDPOINT=sgp1.digitaloceanspaces.com
DO_SPACES_REGION=sgp1
DO_SPACES_BUCKET=weedza-storage
DO_SPACES_ACCESS_KEY=
DO_SPACES_SECRET_KEY=
DO_SPACES_PUBLIC_BASE_URL=https://weedza-storage.sgp1.digitaloceanspaces.com
DO_SPACES_TEAMS_PREFIX=prize
